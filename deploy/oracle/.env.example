# Free DNS hostname that points to the Oracle VM's public IP.
API_DOMAIN=vac-ai-api.example.duckdns.org

# Use the MongoDB Atlas connection string for this app. Keep this file private.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=vac_ai_chat

OLLAMA_MODEL=qwen3.5:0.8b
FRONTEND_ORIGIN=https://chat-bot-ai-anil-charys-projects.vercel.app
