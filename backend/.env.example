MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=vac_ai_chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
# Optional backups. Keys on the same OpenRouter account share its quota.
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
FRONTEND_ORIGIN=http://localhost:5173

# Web search (optional). With a key, Zenoxi uses Tavily (free tier: https://tavily.com).
# Without one it falls back to free, keyless search engines, which can be rate-limited.
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# Max characters of attached-document text sent with each message.
DOC_CONTEXT_CHARS=24000

# ---- Accounts (sign in with an emailed code) ----
# Long random secret used to hash codes and sessions. Required in production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=
# Google sign-in: OAuth "Web application" client ID (same value as VITE_GOOGLE_CLIENT_ID in the frontend)
GOOGLE_CLIENT_ID=
# Email: Brevo (free, works on Render) OR SMTP. With neither, codes are printed to the server log.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Zenoxi
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- WhatsApp & Instagram (optional, see docs/MESSAGING_SETUP.md) ----
PUBLIC_FRONTEND_URL=https://zenoxi.vercel.app
GRAPH_API_VERSION=v23.0
META_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_USERNAME=
# Unified login only (newer Meta apps): the Instagram account ID. Optional: Zenoxi also reads it from incoming webhooks.
INSTAGRAM_ACCOUNT_ID=

# ---- Website Agents ----
# Emails (comma-separated) that can open the Admin dashboard
ADMIN_EMAILS=
# Max visitor messages per agent per day (shared AI) and when the owner adds their own OpenRouter key
AGENT_DAILY_MESSAGES=100
AGENT_DAILY_MESSAGES_OWN_KEY=2000
# Max emails (alerts, confirmations, follow-ups, reports) per agent per day
AGENT_DAILY_EMAILS=50
# Public address of this API (used in unsubscribe links inside emails)
PUBLIC_API_URL=https://chat-bot-ai-ouc2.onrender.com
# Scheduled jobs (lead reports, follow-ups) run inside the server every 30 minutes.
# Optional: also trigger them with POST /api/cron/run and header X-Cron-Secret (e.g. from cron-job.org)
CRON_SECRET=
BACKGROUND_JOBS=true
